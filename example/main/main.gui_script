-- Sample "tap race" game demonstrating the Minit Defold facade end-to-end.
--
-- Flow:
--   init   -> read host config + persisted best, then signal loading_done
--   update -> count down the clock; on time-up, report_result once
--   input  -> each tap bumps the score

local minit = require("minit.minit")

local GAME_SECONDS = 10
local TIME_BONUS = { easy = 5, normal = 0, hard = -3 }

local function fmt_time(t)
    return string.format("Time: %0.1f", math.max(t, 0))
end

function init(self)
    msg.post(".", "acquire_input_focus")

    -- Difficulty is a host-provided config value (URL query param on the web).
    local difficulty = minit.get_config_value("difficulty", "normal")
    self.time_left = GAME_SECONDS + (TIME_BONUS[difficulty] or 0)
    self.score = 0
    self.finished = false

    -- Previous best from the player's persisted single userData slot.
    self.best = tonumber(minit.get_user_data() or "") or 0

    gui.set_text(gui.get_node("score"), "Score: 0")
    gui.set_text(gui.get_node("time"), fmt_time(self.time_left))
    gui.set_text(gui.get_node("best"), "Best: " .. self.best)
    gui.set_text(gui.get_node("hint"), "TAP as fast as you can!")

    -- Nothing to preload — tell the host we're ready to be revealed.
    minit.loading_done()
end

function update(self, dt)
    if self.finished then return end

    self.time_left = self.time_left - dt
    gui.set_text(gui.get_node("time"), fmt_time(self.time_left))

    if self.time_left <= 0 then
        self.finished = true
        gui.set_text(gui.get_node("time"), "Time: 0.0")
        gui.set_text(gui.get_node("hint"), "Done!")

        local is_best = self.score > self.best
        local new_best = math.max(self.best, self.score)
        minit.report_result(self.score, {
            flavor_text = is_best and "New personal best!" or ("Tapped " .. self.score .. " times"),
            user_data = tostring(new_best),
        })
    end
end

function on_input(self, action_id, action)
    if self.finished then return end
    if action_id == hash("touch") and action.pressed then
        self.score = self.score + 1
        gui.set_text(gui.get_node("score"), "Score: " .. self.score)
    end
end
