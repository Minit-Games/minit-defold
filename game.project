[project]
title = Minit Defold Sample
version = 0.2.0

[library]
include_dirs = minit

[bootstrap]
main_collection = /example/main/main.collectionc

[input]
game_binding = /example/input/game.input_bindingc

[display]
width = 720
height = 1280
high_dpi = 1

[html5]
htmlfile = /minit/minit.html
show_fullscreen_button = 0
show_made_with_defold = 0
scale_mode = stretch

[graphics]
default_texture_min_filter = linear
default_texture_mag_filter = linear
